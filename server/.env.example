# WortheyFlow server environment — copy to server/.env for local dev (server/.env is gitignored).
# Never commit real values. On Render, set these under Service > Environment.
PORT=3001

# ---- Required (server refuses to start if any is missing) ----
# Supabase service-role key (Supabase > Project Settings > API). Server-side only.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# JWT signing secret — long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=your_random_jwt_secret
# Shared secret GoHighLevel sends as ?secret=... or x-webhook-secret header
GHL_WEBHOOK_SECRET=your_ghl_webhook_secret
# API key for the AquaBot read-only API (x-api-key header)
AQUABOT_API_KEY=your_aquabot_api_key
# Secret for cron access to /api/daily-report, /api/weekly-report, /api/response-metrics
REPORT_SECRET=your_report_secret

# ---- Optional ----
SUPABASE_URL=https://your-project-ref.supabase.co

# Twilio (SMS is hard-disabled in code; TWILIO_AUTH_TOKEN also validates inbound webhooks)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15555555555
TWILIO_MESSAGING_SERVICE_SID=
# Public base URL Twilio calls (only if signature validation fails behind a proxy)
PUBLIC_BASE_URL=https://wortheyflow.onrender.com

# SendGrid email
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=notifications@wortheyaquatics.com

# Mission Control integration
MC_API_URL=
APP_URL=https://wortheyflow.onrender.com
